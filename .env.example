# Copy to .env.local for local testing, and add the same keys in Vercel:
# Project > Settings > Environment Variables. Never commit the real values.

# Gmail account that sends the quote emails (needs 2-Step Verification on).
GMAIL_USER=en.construction2024@gmail.com
# 16-character app password: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where quote requests are delivered. Defaults to GMAIL_USER if left empty.
QUOTE_TO=en.construction2024@gmail.com

# Google Sheet lead log (see scripts/google-sheets-lead-log.gs). Leave empty to skip.
SHEETS_WEBHOOK_URL=
# Must match SECRET in the Apps Script.
SHEETS_WEBHOOK_SECRET=
